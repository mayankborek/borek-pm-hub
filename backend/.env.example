# Copy this file to ".env" and adjust the values.
# NEVER commit the real .env file. All values below are fake examples.

# local | test | staging | production
ENVIRONMENT=local

# dev = pick a seeded user (Phase 1). entra = Microsoft Entra ID (later).
# local = email + password sign-in (POST /auth/login, bearer token). Needs SECRET_KEY below.
# The app must refuse to start with AUTH_MODE=dev when ENVIRONMENT=production.
AUTH_MODE=dev

# Signs the login tokens (AUTH_MODE=local). At least 32 random characters, different per
# environment, never committed. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
# Sign-in is blocked for LOCKOUT_MINUTES after MAX_FAILED_LOGINS wrong passwords in a row.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Address of the web app, used to build the invite links the administrator hands out
# (<FRONTEND_URL>/set-password#token=...). Empty = the first address in CORS_ORIGINS.
FRONTEND_URL=
# How many days an invite link works
INVITE_VALID_DAYS=7

# Accounts created on start by `python -m scripts.bootstrap_users` (skipped when the password
# is empty or shorter than 12 characters). Choose your own passwords; never commit them.
# The administrator is the first account of a real installation; it creates everyone else.
BOOTSTRAP_ADMIN_EMAIL=admin@borek.test
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_EMAIL=qa.manager@borek.test
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_PM_EMAIL=qa.pm@borek.test
BOOTSTRAP_PM_PASSWORD=
BOOTSTRAP_DEV_EMAIL=qa.dev@borek.test
BOOTSTRAP_DEV_PASSWORD=

# Database (matches the local Docker Compose service)
DATABASE_URL=postgresql+asyncpg://pmhub:change-me@localhost:5432/pmhub

# Database connection pool (per worker)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Cancel any query running longer than this (milliseconds)
DB_STATEMENT_TIMEOUT_MS=30000

# CORS: addresses of the frontend during local development (comma-separated).
# 5173 is the default port of the Vite dev server; confirm with the frontend developer.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Task attachments (files) are saved in this folder (a Docker volume in compose); max size in MB.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Logging
LOG_LEVEL=INFO
