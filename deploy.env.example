# Copy to ".env.prod" (git-ignored) and fill in. Used by docker-compose.prod.yml. Never commit real values.

# PostgreSQL password (letters and digits only, avoids URL-encoding problems)
POSTGRES_PASSWORD=
# Signs login tokens, 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Address(es) the frontend is served from, comma-separated, e.g. https://pmhub.example.com
# (with the bundled web container and no TLS proxy: http://<server-host>:3000)
CORS_ORIGINS=
# Shared password of the demo users pm@/dev1@/dev2@/dev3@borek.test (12+ chars). Remove them when live.
SEED_USER_PASSWORD=
# Optional QA accounts (12+ chars to be created)
BOOTSTRAP_PM_PASSWORD=
BOOTSTRAP_DEV_PASSWORD=
# Host port of the API
API_PORT=8000
# Host port of the web container (frontend); the browser URL must match CORS_ORIGINS
WEB_PORT=3000
# Optional: npm registry mirror if registry.npmjs.org is unreachable from the build host
# NPM_REGISTRY=
